# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中，不会提交）
# Neon Postgres 连接串（从 Neon 控制台复制，形如 postgresql://...）
DATABASE_URL=

# 可选：设为 1 时只抓取不写库，结果输出到 outputs/crawl-result.json（本地调试用）
# DRY_RUN=1

# 可选：智谱 GLM-4-Flash（免费）API Key，配置后爬虫会用 AI 增强分类并生成「适用主题」标签
# 申请地址 https://open.bigmodel.cn/ （不配置则走纯规则分类，零成本）
# ZHIPU_API_KEY=
# GLM_MODEL=glm-4-flash
